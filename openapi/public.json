{
  "basePath": "/api/v1",
  "definitions": {
    "app.Response": {
      "description": "The Response struct is used for wrapping the API response with a code, message, and data.",
      "properties": {
        "code": {
          "description": "Code is the HTTP status code or a custom code used to indicate the result of the request\n@example 200",
          "type": "integer"
        },
        "data": {
          "description": "Data is the response data (can be any object or null)\n@example {\"id\": 1, \"name\": \"John Doe\"}"
        },
        "msg": {
          "description": "Msg is the message that describes the result of the request\n@example \"Request successful\""
        }
      },
      "type": "object"
    },
    "brave.Discussion": {
      "properties": {
        "age": {
          "description": "When the thread was posted, as Brave shows it.",
          "example": "October 24, 2024",
          "type": "string"
        },
        "comment_count": {
          "description": "Number of replies Brave shows for the thread. Omitted when Brave shows none.",
          "example": 30,
          "type": "integer"
        },
        "description": {
          "description": "Short excerpt of the thread as Brave shows it.",
          "example": "I have free time from highschool and want to get into coding, and tips on diving in and learning.",
          "type": "string"
        },
        "favicon": {
          "description": "URL of the site's favicon as Brave serves it.",
          "example": "https://imgs.search.brave.com/example-reddit.ico",
          "type": "string"
        },
        "forum": {
          "description": "Forum or subreddit the thread belongs to, for example `r/pythontips`.",
          "example": "r/pythontips",
          "type": "string"
        },
        "hostname": {
          "description": "Host name of the site hosting the thread.",
          "example": "www.reddit.com",
          "type": "string"
        },
        "path": {
          "description": "Breadcrumb-style path of the thread URL as Brave shows it.",
          "example": "r > pythontips > comments > 1gav6bm > how_to_learn_python",
          "type": "string"
        },
        "position": {
          "description": "Rank of the discussion in the discussions block, starting at 1.",
          "example": 1,
          "type": "integer"
        },
        "score": {
          "description": "Vote score of the thread. Omitted when Brave shows none.",
          "example": 25,
          "type": "integer"
        },
        "title": {
          "description": "Title of the forum thread or question.",
          "example": "How to learn python",
          "type": "string"
        },
        "top_comment": {
          "description": "Text of the top comment Brave shows for the thread.",
          "example": "r/learnpython",
          "type": "string"
        },
        "url": {
          "description": "URL of the discussion thread.",
          "example": "https://www.reddit.com/r/pythontips/comments/1gav6bm/how_to_learn_python/",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.ImageResult": {
      "properties": {
        "age": {
          "description": "Date or time associated with the image page, as Brave shows it.",
          "example": "2026-05-16T12:01:29Z",
          "type": "string"
        },
        "height": {
          "description": "Image height as Brave reports it.",
          "example": 1184,
          "type": "integer"
        },
        "image_url": {
          "description": "URL of the full-size image.",
          "example": "https://example.com/openai.jpg",
          "type": "string"
        },
        "position": {
          "description": "Rank of the image across all result pages, starting at 1.",
          "example": 1,
          "type": "integer"
        },
        "source": {
          "description": "Site the image comes from, for example `area17.com`.",
          "example": "area17.com",
          "type": "string"
        },
        "thumbnail": {
          "description": "URL of the image thumbnail served by Brave.",
          "example": "https://imgs.search.brave.com/example",
          "type": "string"
        },
        "title": {
          "description": "Image title as shown on the Brave results page.",
          "example": "OpenAI colors mobile 08",
          "type": "string"
        },
        "url": {
          "description": "URL of the page the image appears on.",
          "example": "https://area17.com/clients/openai",
          "type": "string"
        },
        "width": {
          "description": "Image width as Brave reports it.",
          "example": 1000,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "brave.ImagesResponse": {
      "properties": {
        "pagination": {
          "allOf": [
            {
              "$ref": "#/definitions/brave.SearchPagination"
            }
          ],
          "description": "Paging information for this response."
        },
        "results": {
          "description": "Image results in Brave's order.",
          "items": {
            "$ref": "#/definitions/brave.ImageResult"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "brave.KnowledgeCard": {
      "properties": {
        "category": {
          "description": "Kind of entity the card describes, for example `computer program`.",
          "example": "computer program",
          "type": "string"
        },
        "description": {
          "description": "One-line description of the entity.",
          "example": "computer program that produces the message \"Hello, world!\", often used to illustrate the basic syntax of a programming language",
          "type": "string"
        },
        "image": {
          "description": "URL of the card's image.",
          "example": "https://imgs.search.brave.com/example-card.png",
          "type": "string"
        },
        "long_description": {
          "description": "Longer description of the entity.",
          "example": "A \"Hello, World!\" program is usually a simple computer program that displays on the screen a message similar to \"Hello, World!\".",
          "type": "string"
        },
        "provider": {
          "allOf": [
            {
              "$ref": "#/definitions/brave.KnowledgeCardProvider"
            }
          ],
          "description": "Source Brave credits for the card."
        },
        "title": {
          "description": "Name of the entity or topic the card is about.",
          "example": "\"Hello, World!\" program",
          "type": "string"
        },
        "url": {
          "description": "URL of the source page the card draws on.",
          "example": "https://en.wikipedia.org/wiki/%22Hello,_World!%22_program",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.KnowledgeCardProvider": {
      "properties": {
        "icon": {
          "description": "URL of the provider's icon.",
          "example": "https://imgs.search.brave.com/example-provider.ico",
          "type": "string"
        },
        "name": {
          "description": "Name of the provider, for example `Wikipedia`.",
          "example": "Wikipedia",
          "type": "string"
        },
        "url": {
          "description": "URL of the provider's page for the entity.",
          "example": "https://en.wikipedia.org/wiki/%22Hello,_World!%22_program",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.NewsResponse": {
      "properties": {
        "pagination": {
          "allOf": [
            {
              "$ref": "#/definitions/brave.SearchPagination"
            }
          ],
          "description": "Paging information for this response."
        },
        "results": {
          "description": "News results in Brave's order.",
          "items": {
            "$ref": "#/definitions/brave.NewsResult"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "brave.NewsResult": {
      "properties": {
        "age": {
          "description": "How long ago the article was published, as Brave shows it.",
          "example": "2 hours ago",
          "type": "string"
        },
        "description": {
          "description": "Article snippet as shown on the Brave results page.",
          "example": "OpenAI announced an update.",
          "type": "string"
        },
        "favicon": {
          "description": "URL of the publisher's favicon as Brave serves it.",
          "example": "https://imgs.search.brave.com/example.ico",
          "type": "string"
        },
        "hostname": {
          "description": "Host name of the article URL.",
          "example": "www.example.com",
          "type": "string"
        },
        "path": {
          "description": "Breadcrumb-style path of the article URL as Brave shows it.",
          "example": "technology > ai",
          "type": "string"
        },
        "position": {
          "description": "Rank of the article across all result pages, starting at 1.",
          "example": 1,
          "type": "integer"
        },
        "source": {
          "description": "Name of the publication, for example `Reuters`.",
          "example": "Reuters",
          "type": "string"
        },
        "thumbnail": {
          "description": "URL of the article thumbnail.",
          "example": "https://imgs.search.brave.com/example-thumb.jpg",
          "type": "string"
        },
        "title": {
          "description": "Article headline as shown on the Brave results page.",
          "example": "OpenAI announces update",
          "type": "string"
        },
        "url": {
          "description": "URL of the news article.",
          "example": "https://example.com/openai-news",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.SearchPagination": {
      "properties": {
        "next_offset": {
          "description": "Offset to request the next page. Omitted when there is no next page.",
          "example": 1,
          "type": "integer"
        },
        "offset": {
          "description": "Zero-based page offset of this response.",
          "example": 0,
          "type": "integer"
        },
        "previous_offset": {
          "description": "Offset to request the previous page. Omitted on the first page.",
          "example": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "brave.SearchResponse": {
      "properties": {
        "discussions": {
          "description": "Forum and Q&A discussions Brave shows for the query. Omitted when there are none.",
          "items": {
            "$ref": "#/definitions/brave.Discussion"
          },
          "type": "array"
        },
        "knowledge_card": {
          "allOf": [
            {
              "$ref": "#/definitions/brave.KnowledgeCard"
            }
          ],
          "description": "Knowledge card Brave shows for the query. Omitted when there is none."
        },
        "pagination": {
          "allOf": [
            {
              "$ref": "#/definitions/brave.SearchPagination"
            }
          ],
          "description": "Paging information for this response."
        },
        "related_queries": {
          "description": "Related searches Brave suggests for the query.",
          "example": [
            "hello world anime",
            "hello world code"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "results": {
          "description": "Organic web results in Brave's order.",
          "items": {
            "$ref": "#/definitions/brave.SearchResult"
          },
          "type": "array"
        },
        "videos": {
          "description": "Video results Brave shows for the query. Omitted when there are none.",
          "items": {
            "$ref": "#/definitions/brave.VideoResult"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "brave.SearchResult": {
      "properties": {
        "age": {
          "description": "How old the page is, as Brave shows it. Omitted when Brave shows none.",
          "example": "1 day ago",
          "type": "string"
        },
        "description": {
          "description": "Result snippet as shown on the Brave results page.",
          "example": "OpenAI helps you build and deploy AI systems.",
          "type": "string"
        },
        "favicon": {
          "description": "URL of the site's favicon as Brave serves it.",
          "example": "https://imgs.search.brave.com/example.ico",
          "type": "string"
        },
        "hostname": {
          "description": "Host name of the result URL.",
          "example": "openai.com",
          "type": "string"
        },
        "path": {
          "description": "Breadcrumb-style path of the result URL as Brave shows it.",
          "example": "research > index",
          "type": "string"
        },
        "position": {
          "description": "Rank of the result on the page, starting at 1.",
          "example": 1,
          "type": "integer"
        },
        "title": {
          "description": "Result title as shown on the Brave results page.",
          "example": "OpenAI",
          "type": "string"
        },
        "url": {
          "description": "URL of the result page.",
          "example": "https://openai.com/",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.SuggestResponse": {
      "properties": {
        "query": {
          "description": "Query prefix the suggestions were requested for.",
          "example": "openai",
          "type": "string"
        },
        "suggestions": {
          "description": "Search suggestions Brave returned, in order.",
          "items": {
            "$ref": "#/definitions/brave.SuggestionResult"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "brave.SuggestionEntity": {
      "properties": {
        "category": {
          "description": "Kind of entity, for example `person`.",
          "example": "person",
          "type": "string"
        },
        "description": {
          "description": "Short description of the entity.",
          "example": "American singer-songwriter (born 1989)",
          "type": "string"
        },
        "image_url": {
          "description": "URL of the entity's image.",
          "example": "https://imgs.search.brave.com/example.jpg",
          "type": "string"
        },
        "logo": {
          "description": "Whether Brave marks the entity image as a logo.",
          "example": false,
          "type": "boolean"
        },
        "name": {
          "description": "Name of the entity.",
          "example": "Taylor Swift",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.SuggestionResult": {
      "properties": {
        "entity": {
          "allOf": [
            {
              "$ref": "#/definitions/brave.SuggestionEntity"
            }
          ],
          "description": "Entity Brave matched to the suggestion. Only set when the request used `rich=true` and Brave recognises an entity."
        },
        "position": {
          "description": "Rank of the suggestion in the list, starting at 1.",
          "example": 1,
          "type": "integer"
        },
        "query": {
          "description": "Suggested search query.",
          "example": "openai api",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.VideoResult": {
      "properties": {
        "age": {
          "description": "When the video was published, as Brave shows it.",
          "example": "March 24, 2024",
          "type": "string"
        },
        "creator": {
          "description": "Channel or creator that published the video.",
          "example": "Train To Code",
          "type": "string"
        },
        "description": {
          "description": "Video description snippet as Brave shows it.",
          "example": "Introducing you to 15 of the most popular programming languages in the world, by writing hello world to the console.",
          "type": "string"
        },
        "duration": {
          "description": "Video length as Brave shows it, for example `08:47`.",
          "example": "08:47",
          "type": "string"
        },
        "favicon": {
          "description": "URL of the hosting site's favicon as Brave serves it.",
          "example": "https://imgs.search.brave.com/example-youtube.ico",
          "type": "string"
        },
        "hostname": {
          "description": "Host name of the video URL.",
          "example": "www.youtube.com",
          "type": "string"
        },
        "path": {
          "description": "Path of the video URL as Brave shows it.",
          "example": "watch",
          "type": "string"
        },
        "platform": {
          "description": "Platform hosting the video, for example `YouTube`.",
          "example": "YouTube",
          "type": "string"
        },
        "position": {
          "description": "Rank of the video among the results, starting at 1; continues across pages in video searches.",
          "example": 1,
          "type": "integer"
        },
        "thumbnail": {
          "description": "URL of the video thumbnail.",
          "example": "https://imgs.search.brave.com/example-thumb.jpg",
          "type": "string"
        },
        "title": {
          "description": "Video title as shown on the Brave results page.",
          "example": "Hello World in 15 Programming Languages - YouTube",
          "type": "string"
        },
        "url": {
          "description": "URL of the video page.",
          "example": "https://www.youtube.com/watch?v=tRUsXTbixIE",
          "type": "string"
        },
        "views": {
          "description": "View count as Brave shows it.",
          "example": "118",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.VideosResponse": {
      "properties": {
        "pagination": {
          "allOf": [
            {
              "$ref": "#/definitions/brave.SearchPagination"
            }
          ],
          "description": "Paging information for this response."
        },
        "results": {
          "description": "Video results in Brave's order.",
          "items": {
            "$ref": "#/definitions/brave.VideoResult"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "brave.imagesResponseDoc": {
      "properties": {
        "code": {
          "example": 200,
          "type": "integer"
        },
        "data": {
          "$ref": "#/definitions/brave.ImagesResponse"
        },
        "msg": {
          "example": "OK",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.newsResponseDoc": {
      "properties": {
        "code": {
          "example": 200,
          "type": "integer"
        },
        "data": {
          "$ref": "#/definitions/brave.NewsResponse"
        },
        "msg": {
          "example": "OK",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.searchResponseDoc": {
      "properties": {
        "code": {
          "example": 200,
          "type": "integer"
        },
        "data": {
          "$ref": "#/definitions/brave.SearchResponse"
        },
        "msg": {
          "example": "OK",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.suggestResponseDoc": {
      "properties": {
        "code": {
          "example": 200,
          "type": "integer"
        },
        "data": {
          "$ref": "#/definitions/brave.SuggestResponse"
        },
        "msg": {
          "example": "OK",
          "type": "string"
        }
      },
      "type": "object"
    },
    "brave.videosResponseDoc": {
      "properties": {
        "code": {
          "example": 200,
          "type": "integer"
        },
        "data": {
          "$ref": "#/definitions/brave.VideosResponse"
        },
        "msg": {
          "example": "OK",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "host": "api.crawlora.net",
  "info": {
    "contact": {
      "email": "support@crawlora.net",
      "name": "API Support",
      "url": "https://crawlora.net"
    },
    "description": "Crawlora is a hosted web-data and SERP API: call documented REST endpoints and get normalized JSON instead of HTML to parse — across search/SERP, maps and local, e-commerce, app stores, social, media and finance. One API key; Crawlora runs the proxy rotation, headless browsers and parsing behind the scenes. Billed pay-on-success: charged only on a successful 2xx response, 1-10 credits per call, with a free tier of 2,000 credits per month and no card. A hosted MCP server (mcp.crawlora.net/mcp) exposes the same catalog as agent tools. Search endpoints accept `q` as a universal alias for whichever search-term parameter they document (`query`, `term`, `keyword`, or Amazon's `k`), so one parameter name works across the whole catalog; an explicitly supplied documented name always wins.",
    "license": {
      "name": "Crawlora Terms of Service",
      "url": "https://crawlora.net/terms"
    },
    "termsOfService": "https://crawlora.net/terms",
    "title": "Crawlora API",
    "version": "1.2",
    "x-logo": {
      "altText": "Crawlora",
      "backgroundColor": "#FFFFFF",
      "url": "https://raw.githubusercontent.com/Crawlora-org/crawlora-mcp/main/assets/logo-400x400.png"
    }
  },
  "paths": {
    "/brave/images": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns Brave image search results for a query string. Locale defaults to country=us and lang=en-us. Returns 503 when Brave serves a challenge page or unusable results.",
        "operationId": "brave-images",
        "parameters": [
          {
            "description": "Search query",
            "in": "query",
            "name": "q",
            "required": true,
            "type": "string",
            "x-example": "openai"
          },
          {
            "description": "Zero-based Brave result page; defaults to 0",
            "in": "query",
            "minimum": 0,
            "name": "offset",
            "type": "integer",
            "x-example": 0
          },
          {
            "description": "Results to return; defaults to 10, clamped to 1..50",
            "in": "query",
            "maximum": 50,
            "minimum": 1,
            "name": "count",
            "type": "integer",
            "x-example": 10
          },
          {
            "description": "Brave result country; defaults to us",
            "enum": [
              "all",
              "ar",
              "at",
              "au",
              "be",
              "br",
              "ca",
              "ch",
              "cl",
              "cn",
              "de",
              "dk",
              "es",
              "fi",
              "fr",
              "gb",
              "gr",
              "hk",
              "id",
              "in",
              "it",
              "jp",
              "kr",
              "mx",
              "my",
              "nl",
              "no",
              "nz",
              "ph",
              "pl",
              "pt",
              "ru",
              "sa",
              "se",
              "sg",
              "tr",
              "tw",
              "us",
              "za"
            ],
            "in": "query",
            "name": "country",
            "type": "string",
            "x-example": "us"
          },
          {
            "description": "Brave UI language; defaults to en-us",
            "enum": [
              "de-de",
              "en-ca",
              "en-gb",
              "en-in",
              "en-us",
              "fi-fi",
              "fr-ca",
              "fr-fr",
              "ja-jp",
              "pt-br",
              "sq-al",
              "sw-ke",
              "zh-tw"
            ],
            "in": "query",
            "name": "lang",
            "type": "string",
            "x-example": "en-us"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/brave.imagesResponseDoc"
            }
          },
          "400": {
            "description": "Missing or invalid query",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "No results found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Brave upstream request failed",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Search Brave image results",
        "tags": [
          "brave"
        ]
      }
    },
    "/brave/news": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns Brave news search results for a query string. Locale defaults to country=us and lang=en-us. Returns 503 when Brave serves a challenge page or unusable results.",
        "operationId": "brave-news",
        "parameters": [
          {
            "description": "Search query",
            "in": "query",
            "name": "q",
            "required": true,
            "type": "string",
            "x-example": "openai"
          },
          {
            "description": "Zero-based Brave result page; defaults to 0",
            "in": "query",
