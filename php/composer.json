{
  "name": "crawlora/brave",
  "description": "Crawlora Brave Search API client with 5 endpoints for web, news, image, and video search plus query suggestions",
  "keywords": [
    "crawlora",
    "api-client",
    "web-scraping",
    "brave",
    "brave-search",
    "web",
    "news",
    "image",
    "video-search-query-suggestions"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Brave\\": "src/Crawlora/Brave/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Brave\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=brave-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-brave",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=brave-php-api-docs"
  }
}
